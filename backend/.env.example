NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/esakhi?replicaSet=rs0
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
GEOCODER_BASE_URL=https://photon.komoot.io

# Generate each separately using: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_128_HEX_CHARACTERS_FROM_RANDOM_BYTES_64
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_128_HEX_SECRET
JWT_REFRESH_TTL_DAYS=7

# Use "development" only for local development/tests. Production requires MSG91.
OTP_PROVIDER=development
DEV_OTP_CODE=246810
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Optional order push notifications. Keep the service account JSON secret server-side.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Delivery remains unavailable until the official Nagar Palika Parishad Damoh
# municipal boundary and server-side address verification have been verified.
LOG_LEVEL=info
